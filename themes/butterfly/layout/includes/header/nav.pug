nav#nav
  span#blog-info
    a.nav-site-title(href=url_for(page.lang === 'en' ? '/en/' : '/'))
      if theme.nav.logo
        img.site-icon(src=url_for(theme.nav.logo) alt='Logo' width='36' height='36')
      if theme.nav.display_title
        span.site-name=config.title
    if globalPageType === 'post' && theme.nav.display_post_title
      a.nav-page-title(href=url_for(page.lang === 'en' ? '/en/' : '/'))
        span.site-name=(page.title || config.title)
        span.site-name
          i.fa-solid.fa-circle-arrow-left
          span= '  ' + _p('post.back_to_home')

  - const languages = language_links()
  a#language-switcher.site-page(href=languages.other hreflang=page.lang === 'en' ? 'zh-CN' : 'en' lang=page.lang === 'en' ? 'zh-CN' : 'en' aria-label=page.lang === 'en' ? '切换到中文' : 'Switch to English' style='margin-left:auto;margin-right:16px;white-space:nowrap')= page.lang === 'en' ? '中文' : 'English'

  details.deal-search
    summary= page.lang === 'en' ? 'Search' : '搜索'
    .deal-search-panel
      label(for='deal-search-input')= page.lang === 'en' ? 'Search deals' : '搜索优惠'
      input#deal-search-input(type='search' data-index=page.lang === 'en' ? '/en/search-v4.json' : '/search-v4.json' autocomplete='off')
      p#deal-search-status(role='status')
      ul#deal-search-results
  #menus
    if theme.search.use
      #search-button
        span.site-page.social-icon.search
          i.fas.fa-search.fa-fw
          span= ' ' + _p('search.title')
    if theme.menu
      != partial('includes/header/menu_item', {}, {cache: true})

      #toggle-menu
        span.site-page
          i.fas.fa-bars.fa-fw